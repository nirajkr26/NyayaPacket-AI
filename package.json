  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"teal,blue\" \"vite\" \"tsx watch server/src/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
